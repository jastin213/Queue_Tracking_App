rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasVerifiedEmail() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
          in ["admin", "Admin", "ADMIN"];
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      allow create: if isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role in ["customer", "Customer", "user", "User"];

      allow update: if isAdmin()
        || (isOwner(userId)
          && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    match /appointments/{appointmentId} {
      allow create: if isSignedIn()
        && hasVerifiedEmail()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.status == "Pending";

      allow read: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if isAdmin();

      match /documents/{documentType} {
        allow create: if isSignedIn()
          && hasVerifiedEmail()
          && request.resource.data.customerId == request.auth.uid
          && request.resource.data.documentType in ["ID", "OR", "CR"]
          && request.resource.data.size <= 10 * 1024 * 1024
          && request.resource.data.chunkCount > 0;

        allow read: if isAdmin()
          || (isSignedIn() && resource.data.customerId == request.auth.uid);

        allow update: if false;
        allow delete: if isAdmin()
          || (isSignedIn() && resource.data.customerId == request.auth.uid);

        match /chunks/{chunkId} {
          allow create: if isSignedIn()
            && hasVerifiedEmail()
            && request.resource.data.customerId == request.auth.uid
            && request.resource.data.index is int
            && request.resource.data.data is bytes
            && request.resource.data.data.size() <= 650 * 1024;

          allow read: if isAdmin()
            || (isSignedIn()
              && resource.data.customerId == request.auth.uid);

          allow update: if false;
          allow delete: if isAdmin()
            || (isSignedIn()
              && resource.data.customerId == request.auth.uid);
        }
      }
    }

    match /queues/{queueDate} {
      allow read: if true;
      allow write: if isAdmin();

      match /items/{queueId} {
        allow read: if true;
        allow create: if isAdmin();
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }
    }

    match /{path=**}/items/{queueId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow read, write: if isAdmin();
    }

    // Lightweight historical copies created by the trusted retention function
    // or by an authenticated administrator using manual retention cleanup.
    match /appointment_archives/{appointmentId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.appointmentId == appointmentId
        && request.resource.data.documentsPurged == true;
      allow delete: if false;
    }

    // Operational status for automated retention. The Admin SDK bypasses rules.
    match /system_config/{configId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
